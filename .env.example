# ── ElevenLabs ──────────────────────────────────────────
# Your ElevenLabs API key (keep scoped / read-only when possible)
ELEVENLABS_API_KEY=
# The Agent ID from your ElevenLabs Conversational AI dashboard
ELEVENLABS_AGENT_ID=

# ── OpenClaw (your self-hosted LLM gateway) ─────────────
# Base URL of your OpenClaw instance (must be HTTPS in production)
# Example: https://my-openclaw.example.com
OPENCLAW_API_BASE_URL=

# ── Public URL ──────────────────────────────────────────
# The publicly reachable URL of THIS bridge service
# Used for webhook registration. Include scheme, no trailing slash.
# Example: https://bridge.my-tunnel.com
PUBLIC_BASE_URL=

# ── Webhook Security ────────────────────────────────────
# Shared secret for validating incoming webhook calls from ElevenLabs
WEBHOOK_SECRET=

# ── Admin API Security ─────────────────────────────────
# Secret key for authenticating requests to admin endpoints
# (/api/memory/{phone_hash} and /api/notes). Required for admin access.
# When not set, admin endpoints return 403 Forbidden.
ADMIN_API_KEY=

# ── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins.
# When not set, CORS middleware is disabled (recommended for webhook-only use).
# Example: https://dashboard.example.com,https://admin.example.com
ALLOWED_ORIGINS=

# ── Phone Hashing Security ─────────────────────────────
# Salt for bcrypt phone number hashing. Must be set in production.
# Generate with: openssl rand -base64 32
# Changing this invalidates all existing caller data (breaking change).
PHONE_HASH_SALT=

# ── Data Encryption ──────────────────────────────────────
# Fernet key for encrypting session records, memories and notes at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required: the bridge refuses to start without it unless ALLOW_PLAINTEXT_STORAGE=true.
DATA_ENCRYPTION_KEY=
# Set to true only to run without encryption (stores caller data unencrypted; not recommended).
ALLOW_PLAINTEXT_STORAGE=

# ── Paths & Runtime ────────────────────────────────────
# Path to the personality/soul template file (Markdown)
SOUL_TEMPLATE_PATH=./soul_template.md
# Directory for the SQLite database bridge.db (sessions, memories, notes)
DATA_DIR=./data

# ── Server ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
